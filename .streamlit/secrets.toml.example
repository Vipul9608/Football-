# Copy this file to .streamlit/secrets.toml (local) or paste it into
# Streamlit Community Cloud -> App settings -> Secrets. Never commit the real file.

# Your API-Football key from https://dashboard.api-football.com (free plan: 100 requests/day).
# Leave it empty or remove it to run the app in demo mode.
API_FOOTBALL_KEY = "your-api-key-here"

# Season start year. The free plan only covers some past seasons, so check your dashboard.
API_FOOTBALL_SEASON = 2023

# Comma-separated league ids: 39 Premier League, 140 La Liga, 78 Bundesliga, 135 Serie A, 61 Ligue 1.
API_FOOTBALL_LEAGUES = "39,140"
